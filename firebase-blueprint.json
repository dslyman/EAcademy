{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string", "maxLength": 30 }
      },
      "required": ["id", "email"]
    },
    "Enrollment": {
      "title": "Enrollment",
      "description": "Course enrollment record",
      "type": "object",
      "properties": {
        "courseId": { "type": "string", "maxLength": 100 },
        "enrolledAt": { "type": "string" }
      },
      "required": ["courseId", "enrolledAt"]
    },
    "Progress": {
      "title": "Progress",
      "description": "Course progress record",
      "type": "object",
      "properties": {
        "courseId": { "type": "string", "maxLength": 100 },
        "completedLessonIds": { "type": "array" },
        "lastLessonId": { "type": "string", "maxLength": 100 },
        "lastAccessedAt": { "type": "string" }
      },
      "required": ["courseId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User document storing profile info"
    },
    "/users/{userId}/enrollments/{enrollmentId}": {
      "schema": "Enrollment",
      "description": "User course enrollments"
    },
    "/users/{userId}/progress/{progressId}": {
      "schema": "Progress",
      "description": "User course progress"
    }
  }
}
